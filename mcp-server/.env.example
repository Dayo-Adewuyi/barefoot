PORT=8787
# 127.0.0.1 when a reverse proxy or tunnel on the same host fronts the server.
HOST=0.0.0.0
# Public HTTPS URL where this server is reachable (ngrok, Render, Fly...). Used for mock pay links.
PUBLIC_BASE_URL=http://localhost:8787
# Shared secret Chord sends as "Authorization: Bearer ..." (register the MCP server with auth_type "bearer").
MCP_BEARER_TOKEN=change-me-to-a-long-random-string

# Paystack TEST secret key. Leave empty to run in offline mock mode. Live keys are refused.
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
# Optional: a Paystack split code to settle supplier / worker / platform shares.
PAYSTACK_SPLIT_CODE=
# Must be a real domain: Paystack rejects reserved TLDs like .example.
PAYER_EMAIL_DOMAIN=care.croupa.com

# Optional relay: forward verified payments to a Chord event subscription.
CHORD_BASE_URL=https://api.chordhq.xyz
CHORD_EVENT_SUBSCRIPTION_ID=
CHORD_EVENT_SIGNING_SECRET=

DATA_FILE=data/ledger.json
SEED_FILE=data/seed.json
