{
  "name": "barefoot-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for the Barefoot Chord teammate: stock, Paystack payments, dispensing and referrals.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx test/smoke.ts",
    "test": "tsx test/signing.ts && tsx test/clinic.ts && tsx test/smoke.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.15.3",
    "tsx": "4.20.3",
    "typescript": "5.9.3"
  }
}
